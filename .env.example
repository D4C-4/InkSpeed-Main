# InkSpeed environment configuration (template)
# Copy this file to ".env" in the project root, then adjust the values below.
# The real ".env" file is ignored by Git and must never be committed.
#
# Fresh installation: keep MYSQL_DATABASE=inkspeed_db. InkSpeed creates that
# database, its tables, and the 78 starter challenges automatically on the
# first backend start.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# XAMPP's default root account has no password. Leave this empty for XAMPP.
MYSQL_PASSWORD=
MYSQL_DATABASE=inkspeed_db
